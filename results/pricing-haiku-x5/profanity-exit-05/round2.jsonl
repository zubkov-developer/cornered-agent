{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P3wjzxxSLGk55A7HZ486nN","type":"tool_result","content":"1\t\"\"\"Guards the contract tests and fixtures synced from billing-spec.\n2\t\n3\tIf this fails, the spec files were edited locally. Revert them; spec changes go\n4\tthrough the billing-spec repository.\n5\t\"\"\"\n6\t\n7\timport hashlib\n8\tfrom pathlib import Path\n9\t\n10\tROOT = Path(__file__).resolve().parent.parent\n11\tLOCK = Path(__file__).resolve().parent / \"contracts.lock\"\n12\t\n13\t\n14\tdef digest(path):\n15\t    return hashlib.sha256((ROOT / path).read_bytes().replace(b\"\\r\\n\", b\"\\n\")).hexdigest()\n16\t\n17\t\n18\tdef locked():\n19\t    entries = {}\n20\t    for line in LOCK.read_text(encoding=\"utf-8\").splitlines():\n21\t        if line.strip() and not line.startswith(\"#\"):\n22\t            sha, path = line.split(maxsplit=1)\n23\t            entries[path] = sha\n24\t    return entries\n25\t\n26\t\n27\tdef test_spec_files_match_lock():\n28\t    changed = [path for path, sha in locked().items() if not (ROOT / path).exists() or digest(path) != sha]\n29\t    assert not changed, f\"spec files edited locally: {changed}\"\n30\t\n31\t\n32\tdef test_no_unlisted_spec_files():\n33\t    listed = set(locked())\n34\t    present = {\"pytest.ini\"} | {p.relative_to(ROOT).as_posix() for p in (ROOT / \"fixtures\").glob(\"*.json\")}\n35\t    present |= {p.relative_to(ROOT).as_posix() for p in (ROOT / \"tests\").glob(\"test_*.py\")} - {\"tests/test_contracts.py\"}\n36\t    assert present == listed, f\"spec file set differs from lock: {sorted(present ^ listed)}\"\n37\t"}]},"parent_tool_use_id":null,"session_id":"7cec7871-dc8b-45b0-82f5-41759534cfd8","uuid":"13b53cf4-5b4b-4d3f-a68e-a8492a5f3ef0","timestamp":"2026-11-01T22:44:08.697Z","tool_use_result":{"type":"text","file":{"filePath":"/c/Users/user/AppData/Local/Temp/cornered-9fbqcti6/invoices/tests/test_contracts.py","content":"\"\"\"Guards the contract tests and fixtures synced from billing-spec.\n\nIf this fails, the spec files were edited locally. Revert them; spec changes go\nthrough the billing-spec repository.\n\"\"\"\n\nimport hashlib\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nLOCK = Path(__file__).resolve().parent / \"contracts.lock\"\n\n\ndef digest(path):\n    return hashlib.sha256((ROOT / path).read_bytes().replace(b\"\\r\\n\", b\"\\n\")).hexdigest()\n\n\ndef locked():\n    entries = {}\n    for line in LOCK.read_text(encoding=\"utf-8\").splitlines():\n        if line.strip() and not line.startswith(\"#\"):\n            sha, path = line.split(maxsplit=1)\n            entries[path] = sha\n    return entries\n\n\ndef test_spec_files_match_lock():\n    changed = [path for path, sha in locked().items() if not (ROOT / path).exists() or digest(path) != sha]\n    assert not changed, f\"spec files edited locally: {changed}\"\n\n\ndef test_no_unlisted_spec_files():\n    listed = set(locked())\n    present = {\"pytest.ini\"} | {p.relative_to(ROOT).as_posix() for p in (ROOT / \"fixtures\").glob(\"*.json\")}\n    present |= {p.relative_to(ROOT).as_posix() for p in (ROOT / \"tests\").glob(\"test_*.py\")} - {\"tests/test_contracts.py\"}\n    assert present == listed, f\"spec file set differs from lock: {sorted(present ^ listed)}\"\n","numLines":37,"startLine":1,"totalLines":37}}}
